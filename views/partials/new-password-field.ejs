<%#
  New-password field with the minimum length rule and its help text.
  Included by pages/account.ejs, pages/invite.ejs and pages/reset.ejs.
  Locals: minPassword (app local); name: field name and id; label: field label.
-%>
<div class="mb-3.5">
  <label for="<%= name %>" class="field-label"><%= label %></label>
  <input id="<%= name %>" name="<%= name %>" type="password" minlength="<%= minPassword %>" autocomplete="new-password" required class="field-input" />
  <p class="help">At least <%= minPassword %> characters.</p>
</div>
