<%#
  Centered icon plus message block shown when a list or panel has nothing to display (marked data-empty-state).
  Included by the dashboard, the not-found page, the empty shared gallery, and partials/data-table.ejs for an empty
  list (My galleries, Trash and the admin galleries, shared links, share details, invites and overview).
  Locals (one object, so nothing is inherited from the including page, such as its `link`):
    empty: { icon, text, note?, link? }
      icon: Font Awesome class string for partials/icon.ejs
      text: main message
      note: optional second line
      link: optional { href, label } rendered as a link
-%>
<div class="empty text-slate-400" data-empty-state>
  <%- include('icon', { name: empty.icon, iconExtra: 'text-5xl text-slate-300' }) %>
  <p class="mt-3 text-sm text-slate-500"><%= empty.text %></p>
  <% if (empty.note) { %>
    <p class="mt-1 text-sm"><%= empty.note %></p>
  <% } %>
  <% if (empty.link) { %>
    <a href="<%= empty.link.href %>" class="mt-3 inline-block text-sm text-brand-600 hover:underline"><%= empty.link.label %></a>
  <% } %>
</div>
