# GalleryShare settings. Copy this file to .env and fill in the blanks.
# Empty or invalid values fall back to the default shown in each comment.

# Runtime environment: development | production | test (default development).
# production requires SESSION_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD and PUBLIC_URL (the app refuses to start)
NODE_ENV=development

# HTTP port
PORT=3000

# Bind address
HOST=127.0.0.1

# Express "trust proxy" (1, true, or a subnet). Also makes the session cookie Secure.
TRUST_PROXY=

# Public base URL for invite, reset and share links, e.g. https://photos.example.com.
PUBLIC_URL=

# Owner admin. Required in production (the app refuses to start without them); set both or neither.
# At every start the app creates this admin, or makes it an enabled admin again.
# Changing ADMIN_PASSWORD resets this admin's password at the next start and signs it out everywhere.
ADMIN_EMAIL=

# At least 10 characters
ADMIN_PASSWORD=

# Display name used when the admin is first created (default: Admin)
ADMIN_NAME=

# Signs anonymous form tokens and share links. Required in production.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session lifetime in days (1 to 3650, default 30)
SESSION_DAYS=30

# Force the Secure cookie flag (always on in production or behind TRUST_PROXY)
COOKIE_SECURE=false

# 32-byte key (64 hex chars or base64) encrypting pending invite links so Admin, Invites can copy them again.
# Generate with the same command as SESSION_SECRET (run it again for a different value).
SETTINGS_ENC_KEY=

# SQLite database file (default ./data/galleryshare.sqlite)
DATABASE_PATH=./data/galleryshare.sqlite

# Folder for stored images (original, web and thumbnail copies; default ./data/media)
MEDIA_DIR=./data/media

# Folder for uploads while they are being processed (default ./data/tmp).
# Must be a folder of its own: not MEDIA_DIR. Leftover files are removed at every start.
TMP_UPLOAD_DIR=./data/tmp

# Days a deleted gallery stays in Trash before it is deleted for good (1 to 3650, default 30)
TRASH_RETENTION_DAYS=30

# Days activity (the Activity pages) is kept (1 to 3650, default 90)
ACTIVITY_RETENTION_DAYS=90

# Folder for the daily log files app-YYYY-MM-DD.log (default ./data/logs)
LOG_DIR=./data/logs

# Days a log file is kept (1 to 3650, default 30)
LOG_RETENTION_DAYS=30

# Console log level: error, warn, info or debug (default info). The log files always take info and above.
LOG_LEVEL=info

# Sign-in, invite and password-reset form submissions allowed per IP per window (default 10)
RATE_LIMIT_PUBLIC_FORM_MAX=10

# Failed share-link lookups (wrong, revoked or paused /s/<token> links, pages and images) allowed per IP per window;
# blank means the same as RATE_LIMIT_PUBLIC_FORM_MAX
RATE_LIMIT_SHARE_MAX=

# ZIP downloads (/s/<token>/zip) allowed per IP per window (default 5)
RATE_LIMIT_ZIP_MAX=5

# Rate limit window in milliseconds (1 to 86400000, one day; default 900000)
RATE_LIMIT_WINDOW_MS=900000

# Show each image's title and caption under its thumbnail on a shared gallery (true or false, default true).
SHARE_GRID_TEXT=true

# Look of shared gallery pages: none, frame, dark-wall, app-window, polaroid, glass or paper-stack (default none).
SHARE_THEME=none

# What a click on a shared thumbnail does: lightbox, new-tab or page (default lightbox).
SHARE_IMAGE_VIEW=lightbox

# Rows per page in lists such as galleries, Trash, Activity and Admin (5 to 100, default 25)
ITEMS_PER_PAGE=25

# Largest single image in MB (1 to 200, default 25)
MAX_IMAGE_MB=25

# Largest ZIP upload in MB (1 to 5000, default 500)
MAX_ZIP_UPLOAD_MB=500

# Most images in one gallery (1 to 5000, default 500)
MAX_IMAGES_PER_GALLERY=500

# Storage per user in MB (0 = unlimited, up to 10000000, default 0)
USER_QUOTA_MB=0

# Largest total of one upload batch in MB (1 to 10000, default 1000)
MAX_UPLOAD_BATCH_MB=1000
