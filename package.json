{
  "name": "galleryshare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/css/app.css --minify",
    "dev:css": "npm run build:css -- --watch",
    "dev": "npm run build:css && node --watch server.js",
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --ui",
    "seed:demo": "node scripts/seed-demo.js",
    "screenshots": "playwright test --config playwright.screenshots.config.js && npm run build:screenshots",
    "build:screenshots": "node scripts/build-screenshot-gallery.js && tailwindcss -c tailwind.screenshots.config.js -i src/gallery/gallery.css -o public/screenshots/gallery.css --minify",
    "format": "prettier --write \"**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs}\""
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "acorn": "^8.19.0",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19"
  }
}
