<%#
  Inline "Delete?" confirm: a hidden panel with an amber prompt, a Yes
  button that POSTs to `action` (with CSRF) and a No button. public/js/inline-confirm.js shows it
  when the [data-confirm-open] button in the same [data-confirm] group is clicked.
  Included by partials/danger-confirm.ejs, which pairs it with its danger button.
  Locals (one object, so nothing is inherited from the including page): confirm: { action, prompt? } action: POST
  URL; prompt: optional confirm text (default 'Delete?'); csrfToken (chrome local).
-%>
<span data-confirm-panel hidden class="inline-flex flex-wrap items-center gap-2">
  <span class="pill pill-amber">
    <%- include('icon', { name: 'fa-solid fa-triangle-exclamation' }) %>
    <%= confirm.prompt || 'Delete?' %>
  </span>
  <%- include('post-button', { post: { action: confirm.action, label: 'Yes', btn: 'btn-danger btn-sm', formClass: 'inline' } }) %>
  <button type="button" data-confirm-cancel class="btn btn-quiet btn-sm">No</button>
</span>
